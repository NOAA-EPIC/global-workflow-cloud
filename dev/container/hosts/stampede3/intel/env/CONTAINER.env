#! /usr/bin/env bash

# Define if run with container, default as NO.
export RUN_WITH_CONTAINER=YES

export CONTAINER_BINDINGS="-B /work2 -B /scratch"
#export CONTAINER_SIF="/work2/11244/huangwei/stampede3/container/containers/ubuntu22.04-intel-ss1.9.2.sif"
export CONTAINER_SIF="/work2/11244/huangwei/stampede3/container/containers/ubuntu22.04-intel-ufs-env-v1.9.2-runtime.img"
#export CONTAINER_FORECAST="${HOMEglobal}/dev/container/prefix/container_forecast.sh"
#export CONTAINER_GFSUTILS="${HOMEglobal}/dev/container/prefix/container_gfsutils.sh"
export CONTAINER_FORECAST="/work2/11244/huangwei/stampede3/src/global-workflow-cloud/dev/container/prefix/container_forecast.sh"
export CONTAINER_GFSUTILS="/work2/11244/huangwei/stampede3/src/global-workflow-cloud/dev/container/prefix/container_gfsutils.sh"

# if within container, will run python executbale inside container,
# also need to tell some scripts that it is run in container, with "-c" option.
#export PYCMD="${HOMEglobal}/dev/container/prefix/container_python.sh"
export PYCMD="/work2/11244/huangwei/stampede3/src/global-workflow-cloud/dev/container/prefix/container_python.sh"
export PYEXTRAARGS=" -c -v"
