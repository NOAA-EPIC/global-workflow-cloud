#! /usr/bin/env bash

# Define if run with container, default as NO.
export RUN_WITH_CONTAINER=YES

export CONTAINER_BINDINGS="-B /scratch3 -B /scratch4 -B /scratch5"
export CONTAINER_SIF="/scratch3/NCEPDEV/nems/role.epic/containers/ubuntu22.04-intel-ufs-env-v1.9.2.img"
export CONTAINER_FORECAST="/scratch5/purged/Wei.Huang/src/global-workflow-cloud/dev/container/prefix/container_forecast.sh"
export CONTAINER_GFSUTILS="/scratch5/purged/Wei.Huang/src/global-workflow-cloud/dev/container/prefix/container_gfsutils.sh"

# if within container, will run python executbale inside container,
# also need to tell some scripts that it is run in container, with "-c" option.
export PYCMD="/scratch5/purged/Wei.Huang/src/global-workflow-cloud/dev/container/prefix/container_python.sh"
export PYEXTRAARGS=" -c -v"
